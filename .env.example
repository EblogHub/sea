NODE_ENV=development
PORT=3000
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/acada_cart?schema=public
SESSION_COOKIE_NAME=acada_session
SESSION_SECRET=replace-with-at-least-32-random-bytes
IDENTITY_HASH_SECRET=replace-with-a-separate-32-byte-random-secret
S3_REGION=auto
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_BUCKET=acada-cart-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
